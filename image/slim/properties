# Lines for the device's waydroid.cfg [properties] (docs/slim.md), by stage.
# Waydroid writes them to waydroid_base.prop, which init reads as
# /vendor/waydroid.prop after the image's build.prop, so they override it.

# S2: one 64-bit zygote (init.zygote64.rc from the overlay). ro.product.cpu.abilist
# set explicitly stops init deriving the lists, so all three are given; no
# 32-bit ABI means 32-bit-only apps fail to install instead of failing to start.
ro.zygote = zygote64
ro.product.cpu.abilist = arm64-v8a
ro.product.cpu.abilist64 = arm64-v8a
ro.product.cpu.abilist32 =

# S7: smaller idle heaps in every app process (more frequent GC).
dalvik.vm.heaptargetutilization = 0.75
dalvik.vm.heapminfree = 512k
dalvik.vm.heapmaxfree = 8m
