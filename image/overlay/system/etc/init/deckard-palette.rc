# Android's system colours follow Marathon's ambience: deckardd writes
# /data/deckard/palette and this applies it as a fabricated overlay.
service deckard-palette /system/bin/inotifyd /system/bin/deckard-palette /data/deckard:mw
    class main
    user system
    group system
    disabled

on post-fs-data
    mkdir /data/deckard 0755 system system

on property:sys.boot_completed=1
    exec_background - system system -- /system/bin/deckard-palette m /data/deckard palette
    start deckard-palette
