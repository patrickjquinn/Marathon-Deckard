<?xml version="1.0" encoding="utf-8"?>
<!-- microG Services and Companion (docs/microg.md). Granted: what location
     and push need. Denied: Wi-Fi and cell scanning (location comes from
     Marathon), telephony, USB and FIDO, credential provider service,
     other users, dumps, installing. -->
<permissions>
    <privapp-permissions package="com.google.android.gms">
        <permission name="android.permission.INSTALL_LOCATION_PROVIDER"/>
        <permission name="android.permission.CHANGE_DEVICE_IDLE_TEMP_WHITELIST"/>
        <permission name="android.permission.UPDATE_APP_OPS_STATS"/>
        <permission name="android.permission.UPDATE_DEVICE_STATS"/>
        <permission name="android.permission.WATCH_APPOPS"/>
        <deny-permission name="android.permission.LOCATION_HARDWARE"/>
        <deny-permission name="android.permission.NETWORK_SCAN"/>
        <deny-permission name="android.permission.MODIFY_PHONE_STATE"/>
        <deny-permission name="android.permission.MANAGE_USB"/>
        <deny-permission name="android.permission.START_ACTIVITIES_FROM_BACKGROUND"/>
        <deny-permission name="android.permission.DUMP"/>
        <deny-permission name="android.permission.INTERACT_ACROSS_USERS"/>
        <deny-permission name="android.permission.PROVIDE_DEFAULT_ENABLED_CREDENTIAL_SERVICE"/>
        <deny-permission name="android.permission.PROVIDE_REMOTE_CREDENTIALS"/>
    </privapp-permissions>
    <privapp-permissions package="com.android.vending">
        <deny-permission name="android.permission.INSTALL_PACKAGES"/>
        <deny-permission name="android.permission.DELETE_PACKAGES"/>
        <deny-permission name="android.permission.INTERACT_ACROSS_USERS"/>
    </privapp-permissions>
</permissions>
