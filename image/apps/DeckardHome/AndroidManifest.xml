<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.marathonos.deckard.home"
    android:sharedUserId="android.uid.system"
    android:versionCode="1"
    android:versionName="0.1.0">

    <uses-sdk android:minSdkVersion="33" android:targetSdkVersion="33" />

    <!-- Android's activity manager needs a home; Marathon's is the real one.
         The hwcomposer never maps this package (deckard.blacklist_apps).
         Platform-signed so it runs in DeckardSystem's process, not its own. -->
    <application
        android:label="Deckard Home"
        android:allowBackup="false"
        android:hasCode="true"
        android:process="org.marathonos.deckard.system">

        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:resumeWhilePausing="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter android:priority="2">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
