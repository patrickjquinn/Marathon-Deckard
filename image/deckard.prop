# Android properties deckard-overlay-sync puts into deckard.cfg and
# deckard_base.prop: arm64 only, with the overlay's zygote rc (docs/slim.md).
ro.product.cpu.abilist=arm64-v8a
ro.product.cpu.abilist64=arm64-v8a
ro.product.cpu.abilist32=
# lmkd without pressure monitors: it still sets each app's oom_score_adj for
# ActivityManager, while deckardd's reclaimer does the killing (docs/bridge.md).
ro.lmk.use_new_strategy=true
ro.lmk.psi_partial_stall_ms=0
ro.lmk.psi_complete_stall_ms=0
# SurfaceFlinger doesn't prime RenderEngine's shader cache at boot: 35 MiB of
# anonymous memory for composition the hwcomposer never asks it to do.
service.sf.prime_shader_cache=0
# System services Deckard's 23.2 image leaves out (SystemServiceManager reads
# the list; older images ignore it). Each one's instance is unused by its
# caller; measured with the regression apps (docs/slim.md, E4).
ro.deckard.skip_system_services=AdServicesManagerService$Lifecycle,OnDevicePersonalizationSystemService$Lifecycle,ProfilingService$Lifecycle,SelectionToolbarManagerService,HealthConnectManagerService,DeviceLockService,WearableSensingManagerService,SoundTriggerService,SoundTriggerMiddlewareService$Lifecycle,AttestationVerificationManagerService,BinaryTransparencyService,IntrusionDetectionService,AdvancedProtectionService$Lifecycle,TradeInModeService,AppFunctionManagerService,DynamicInstrumentationManagerService,EmergencyAffordanceService
# SurfaceFlinger on work durations that fit one frame, not the image's phase
# offsets, which hold each app frame a period longer; -1 unsets the offsets,
# without which SurfaceFlinger aborts in this mode.
debug.sf.use_phase_offsets_as_durations=1
ro.surface_flinger.vsync_event_phase_offset_ns=-1
ro.surface_flinger.vsync_sf_event_phase_offset_ns=-1
debug.sf.late.sf.duration=5000000
debug.sf.late.app.duration=11666666
# Marathon draws an app's launch, splash included: no Android splash after it
# (frameworks/base patch; older images ignore it).
ro.deckard.starting_windows=false
# Android's PinnerService locked 20 MB of WebView in RAM for an app that is
# rarely open in Deckard.
pinner.pin_webview_size=0
# Who built the image, where: neutral, as GrapheneOS's are. The image's own
# are the builder's login and host, which every app could read (and banking
# apps match on). The description keeps what it says about the build.
ro.build.user=build-user
ro.build.host=build-host
ro.build.description=lineage_deckard_arm64_only-userdebug 16 BP4A.251205.006 eng.build test-keys
# The hardware by Deckard's name, as ro.board.platform has it: "unknown" and
# an empty board are what emulators report.
ro.hardware=deckard
ro.product.board=deckard
