+namespace {
+GLuint yuv_program() {
+    static GLuint program = 0;
+    if (program)
+        return program;
+    const char *vs =
+            "attribute vec2 pos;\n"
+            "varying vec2 uv;\n"
+            "void main() { uv = pos * 0.5 + 0.5; gl_Position = vec4(pos, 0.0, 1.0); }\n";
+    const char *fs =
+            "#extension GL_OES_EGL_image_external : require\n"
+            "precision mediump float;\n"
+            "uniform samplerExternalOES tex;\n"
+            "varying vec2 uv;\n"
+            "void main() { gl_FragColor = vec4(texture2D(tex, uv).rgb, 1.0); }\n";
+    GLuint shaders[2] = { glCreateShader(GL_VERTEX_SHADER), glCreateShader(GL_FRAGMENT_SHADER) };
+    glShaderSource(shaders[0], 1, &vs, nullptr);
+    glShaderSource(shaders[1], 1, &fs, nullptr);
+    program = glCreateProgram();
+    for (GLuint shader : shaders) {
+        glCompileShader(shader);
+        glAttachShader(program, shader);
+    }
+    glBindAttribLocation(program, 0, "pos");
+    glLinkProgram(program);
+    GLint linked = GL_FALSE;
+    glGetProgramiv(program, GL_LINK_STATUS, &linked);
+    if (!linked)
+        ALOGE("yuv_program: link failed");
+    return program;
+}
+
+void draw_yuv(struct display* display, struct buffer* buf) {
+    const auto &metadata = buf->metadata;
+    android::sp<android::GraphicBuffer> source = new android::GraphicBuffer(
+            (native_handle_t*)buf->handle, android::GraphicBuffer::WRAP_HANDLE,
+            metadata.width, metadata.height, metadata.format, 1 /* layers */,
+            (uint64_t) android::GraphicBuffer::USAGE_HW_TEXTURE, metadata.pixel_stride);
+    EGLint image_attrs[] = { EGL_IMAGE_PRESERVED_KHR, EGL_TRUE, EGL_NONE };
+    EGLImageKHR src = eglCreateImageKHR(display->egl_dpy, EGL_NO_CONTEXT, EGL_NATIVE_BUFFER_ANDROID,
+                                        (EGLClientBuffer) source->getNativeBuffer(), image_attrs);
+    EGLImageKHR dst = eglCreateImageKHR(display->egl_dpy, EGL_NO_CONTEXT, EGL_NATIVE_BUFFER_ANDROID,
+                                        (EGLClientBuffer) buf->converted->getNativeBuffer(), image_attrs);
+    if (src == EGL_NO_IMAGE_KHR || dst == EGL_NO_IMAGE_KHR) {
+        ALOGE("draw_yuv: eglCreateImageKHR failed: %s", eglStrError(eglGetError()));
+    } else {
+        GLuint textures[2];
+        glGenTextures(2, textures);
+        glBindTexture(GL_TEXTURE_EXTERNAL_OES, textures[0]);
+        glTexParameteri(GL_TEXTURE_EXTERNAL_OES, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+        glTexParameteri(GL_TEXTURE_EXTERNAL_OES, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+        glEGLImageTargetTexture2DOES(GL_TEXTURE_EXTERNAL_OES, src);
+        glBindTexture(GL_TEXTURE_2D, textures[1]);
+        glEGLImageTargetTexture2DOES(GL_TEXTURE_2D, dst);
+        glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, textures[1], 0);
+
+        static const GLfloat quad[] = { -1, -1, 1, -1, -1, 1, 1, 1 };
+        glViewport(0, 0, metadata.width, metadata.height);
+        glUseProgram(yuv_program());
+        glBindTexture(GL_TEXTURE_EXTERNAL_OES, textures[0]);
+        glVertexAttribPointer(0, 2, GL_FLOAT, GL_FALSE, 0, quad);
+        glEnableVertexAttribArray(0);
+        glDrawArrays(GL_TRIANGLE_STRIP, 0, 4);
+        // The compositor samples the buffer as soon as it is committed.
+        glFinish();
+
+        glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, 0, 0);
+        glDeleteTextures(2, textures);
+    }
+    if (src != EGL_NO_IMAGE_KHR)
+        eglDestroyImageKHR(display->egl_dpy, src);
+    if (dst != EGL_NO_IMAGE_KHR)
+        eglDestroyImageKHR(display->egl_dpy, dst);
+}
+}
+
+void egl_convert_yuv(struct display* display, struct buffer* buf) {
+    display->egl_work_queue.emplace_back(std::bind(draw_yuv, display, buf));
+    sem_post(&display->egl_go);
+    sem_wait(&display->egl_done);
+}
+
 void* egl_loop(void* data) {
     struct display* display = (struct display*) data;
     egl_init(display);
