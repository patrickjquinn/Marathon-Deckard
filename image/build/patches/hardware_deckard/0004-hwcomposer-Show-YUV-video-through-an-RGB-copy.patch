+std::unique_ptr<buffer> create_converted_wl_buffer(wl_conn *conn, const buffer_metadata& metadata, buffer_handle_t handle) {
+    android::sp<android::GraphicBuffer> rgb = new android::GraphicBuffer(
+            metadata.width, metadata.height, HAL_PIXEL_FORMAT_BGRA_8888, 1,
+            GRALLOC_USAGE_HW_RENDER | GRALLOC_USAGE_HW_TEXTURE | GRALLOC_USAGE_HW_COMPOSER, "deckard-yuv");
+    if (rgb->initCheck() != android::OK) {
+        ALOGE("create_converted_wl_buffer: allocating %ux%u failed", metadata.width, metadata.height);
+        return nullptr;
+    }
+    auto *cros = reinterpret_cast<const cros_gralloc_handle *>(rgb->handle);
+    if (cros->format_modifier != DRM_FORMAT_MOD_LINEAR) {
+        ALOGE("create_converted_wl_buffer: modifier 0x%" PRIx64 " is not linear", (uint64_t)cros->format_modifier);
+        return nullptr;
+    }
+    auto buf = create_dmabuf_wl_buffer(conn, metadata, cros->fds[0], DRM_FORMAT_ARGB8888, cros->strides[0],
+                                       cros->offsets[0], DRM_FORMAT_MOD_LINEAR, handle);
+    buf->converted = rgb;
+    return buf;
+}
 std::unique_ptr<buffer> create_buffer_cros(wl_conn *conn, const buffer_metadata& metadata, buffer_handle_t handle) {
+    // Compositors that cannot import planar YUV kill the connection over it.
+    if (is_yuv_format(metadata.format)) {
+        if (auto buf = create_converted_wl_buffer(conn, metadata, handle))
+            return buf;
+        return create_shm_wl_buffer(conn, metadata, handle);
+    }
     auto *cros_handle = reinterpret_cast<const cros_gralloc_handle *>(handle);
     return create_dmabuf_wl_buffer(conn, metadata, cros_handle->fds[0], cros_handle->format, cros_handle->strides[0], cros_handle->offsets[0], cros_handle->format_modifier, handle);
 }
@@ -396,6 +427,38 @@ bool cpu_render_to_pixels(buffer *buffer) {
     return ok;
 }
 
+bool is_yuv_format(uint32_t hal_format) {
+    return hal_format == HAL_PIXEL_FORMAT_YV12
+        || hal_format == HAL_PIXEL_FORMAT_YCBCR_420_888
+        || hal_format == HAL_PIXEL_FORMAT_YCRCB_420_SP;
+}
+
+void update_shm_buffer_yuv(buffer *buffer) {
+    const auto &metadata = buffer->metadata;
+    android_ycbcr ycbcr {};
+    android::Rect bounds(metadata.width, metadata.height);
+    if (android::GraphicBufferMapper::get().lockYCbCr(buffer->handle, GRALLOC_USAGE_SW_READ_OFTEN,
+                                                      bounds, &ycbcr) != android::OK) {
+        ALOGE("update_shm_buffer_yuv: lock failed for %p", buffer->handle);
+        return;
+    }
+    auto *dst = static_cast<uint8_t *>(buffer->shm_data);
+    int dst_stride = metadata.width * 4;
+    auto *y = static_cast<const uint8_t *>(ycbcr.y);
+    auto *cb = static_cast<const uint8_t *>(ycbcr.cb);
+    auto *cr = static_cast<const uint8_t *>(ycbcr.cr);
+    int ys = ycbcr.ystride, cs = ycbcr.cstride;
+    int w = metadata.width, h = metadata.height;
+    // libyuv's ARGB is the B,G,R,A byte order WL_SHM_FORMAT_XRGB8888 wants.
+    if (ycbcr.chroma_step == 1)
+        libyuv::I420ToARGB(y, ys, cb, cs, cr, cs, dst, dst_stride, w, h);
+    else if (cr == cb + 1)
+        libyuv::NV12ToARGB(y, ys, cb, cs, dst, dst_stride, w, h);
+    else
+        libyuv::NV21ToARGB(y, ys, cr, cs, dst, dst_stride, w, h);
+    android::GraphicBufferMapper::get().unlock(buffer->handle);
+}
+
 namespace {
 void update_shm_buffer_generic(display *display, buffer *buffer) {
     display->egl_work_queue.emplace_back(std::bind(egl_render_to_pixels, display, buffer));
