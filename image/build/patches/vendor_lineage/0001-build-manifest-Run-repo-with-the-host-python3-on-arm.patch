From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: patrickjquinn <patrick.jm.quinn@gmail.com>
Date: Mon, 26 Oct 2026 05:35:12 +0000
Subject: [PATCH] build-manifest: Run repo with the host python3 on arm64 hosts

build-manifest.xml failed on an aarch64 build host with
"ModuleNotFoundError: No module named '_ssl'": repo imports ssl at
startup, and prebuilts/build-tools' linux-arm64 py3-cmd, unlike the
linux-x86 one, is built without _ssl (or _hashlib). Use /usr/bin/python3
there.

Change-Id: Ib576a012985d7d0eb5e98c21ceda3dee57f9e2df
---
 build/tasks/build-manifest_xml.mk | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/build/tasks/build-manifest_xml.mk b/build/tasks/build-manifest_xml.mk
index 5f54967..c4af18f 100644
--- a/build/tasks/build-manifest_xml.mk
+++ b/build/tasks/build-manifest_xml.mk
@@ -16,9 +16,15 @@ ifdef MANIFEST_EXCLUDES
 MANIFEST_EXCLUDES := |$(MANIFEST_EXCLUDES)
 endif
 
+# The arm64 prebuilt python3 has no _ssl module, which repo imports.
+BUILD_MANIFEST_PYTHON := python3
+ifeq ($(HOST_ARCH),arm64)
+BUILD_MANIFEST_PYTHON := /usr/bin/python3
+endif
+
 $(INSTALLED_BUILD_MANIFEST_XML_TARGET):
 	mkdir -p $(dir $@)
-	REPO_TRACE=0 python3 .repo/repo/repo manifest -o - -r | grep -Ev "proprietary_$(MANIFEST_EXCLUDES)" > $@
+	REPO_TRACE=0 $(BUILD_MANIFEST_PYTHON) .repo/repo/repo manifest -o - -r | grep -Ev "proprietary_$(MANIFEST_EXCLUDES)" > $@
 
 .PHONY: build-manifest.xml
 build-manifest.xml: $(INSTALLED_BUILD_MANIFEST_XML_TARGET)
