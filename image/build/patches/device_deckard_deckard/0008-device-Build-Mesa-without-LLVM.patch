From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: patrickjquinn <patrick.jm.quinn@gmail.com>
Date: Wed, 28 Oct 2026 08:20:01 +0000
Subject: [PATCH] device: Build Mesa without LLVM

Only llvmpipe, lavapipe, radeonsi and radv need LLVM, and no Deckard
device has their hardware: the phones and the Pi run v3d/vc4, etnaviv,
lima and panfrost, the QEMU simulator virgl. libLLVM was 34 MiB of PSS,
26 MiB resident in each of zygote, SurfaceFlinger, the composer and the
allocator, and about 150 MB of the vendor image. softpipe stays as the
software fallback; svga, nouveau and tegra go with them.
---
 BoardConfig.mk                    | 4 ++--
 deckard_arm64_only/BoardConfig.mk | 2 +-
 device.mk                         | 1 -
 3 files changed, 3 insertions(+), 4 deletions(-)

diff --git a/BoardConfig.mk b/BoardConfig.mk
index 42e4b3a..18f9192 100644
--- a/BoardConfig.mk
+++ b/BoardConfig.mk
@@ -39,8 +39,8 @@ ifneq ($(TARGET_USE_MESA),false)
 BOARD_MESA3D_USES_MESON_BUILD := true
 BOARD_MESA3D_MESON_ARGS := -Dallow-kcmp=enabled -Dmesa-clc=system -Dprecomp-compiler=system
 BOARD_MESA3D_BUILD_LIBGBM := true
-BOARD_MESA3D_GALLIUM_DRIVERS := llvmpipe svga virgl radeonsi zink
-BOARD_MESA3D_VULKAN_DRIVERS := swrast virtio amd
+BOARD_MESA3D_GALLIUM_DRIVERS := softpipe virgl zink
+BOARD_MESA3D_VULKAN_DRIVERS := virtio
 endif
 
 # Filesystem
diff --git a/deckard_arm64_only/BoardConfig.mk b/deckard_arm64_only/BoardConfig.mk
index 9c85390..3273f3a 100644
--- a/deckard_arm64_only/BoardConfig.mk
+++ b/deckard_arm64_only/BoardConfig.mk
@@ -32,7 +32,7 @@ TARGET_2ND_CPU_VARIANT :=
 AUDIOSERVER_MULTILIB := first
 
 ifneq ($(TARGET_USE_MESA),false)
-BOARD_MESA3D_GALLIUM_DRIVERS += asahi freedreno v3d vc4 etnaviv nouveau tegra panfrost lima
+BOARD_MESA3D_GALLIUM_DRIVERS += asahi freedreno v3d vc4 etnaviv panfrost lima
 BOARD_MESA3D_VULKAN_DRIVERS += asahi broadcom freedreno panfrost
 BOARD_MESA3D_GALLIUM_VA := disabled
 BOARD_MESA3D_VIDEO_CODECS := all
diff --git a/device.mk b/device.mk
index cdf1808..bc65f94 100644
--- a/device.mk
+++ b/device.mk
@@ -136,7 +136,6 @@ PRODUCT_PACKAGES += \
     libGLESv2_mesa \
     libgallium_dri \
     libgbm_mesa_wrapper \
-    vulkan.lvp \
     vulkan.virtio
 
 ifneq ($(filter %_x86 %_x86_64,$(TARGET_PRODUCT)),)
-- 
2.55.0

