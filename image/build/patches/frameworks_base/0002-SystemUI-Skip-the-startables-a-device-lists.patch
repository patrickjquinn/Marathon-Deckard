         mServices = new CoreStartable[startables.size() + (vendorComponent == null ? 0 : 1)];
 
         if (!mBootCompleteCache.isBootComplete()) {
@@ -290,8 +295,6 @@ public class SystemUIApplicationImpl extends SystemUIApplication implements
                 Trace.TRACE_TAG_APP);
         log.traceBegin(metricsPrefix);
 
-        HashSet<Class<?>> startedStartables = new HashSet<>();
-
         // Perform a form of topological sort:
         // 1) Iterate through a queue of all non-started startables
         //   If the startable has all of its dependencies met
@@ -391,6 +394,33 @@ public class SystemUIApplicationImpl extends SystemUIApplication implements
         mServicesStarted = true;
     }
 
+    /**
+     * The startables without those whose simple class names ({@code $} for nested classes)
+     * are listed in {@code ro.deckard.skip_systemui_startables}; those go into {@code skipped}.
+     */
+    private static Map<Class<?>, Provider<CoreStartable>> withoutSkipped(
+            Map<Class<?>, Provider<CoreStartable>> startables, Set<Class<?>> skipped) {
+        String list = SystemProperties.get("ro.deckard.skip_systemui_startables", "");
+        if (list.isEmpty()) {
+            return startables;
+        }
+        Set<String> names = new HashSet<>();
+        for (String name : list.split(",")) {
+            names.add(name.trim());
+        }
+        Map<Class<?>, Provider<CoreStartable>> kept = new LinkedHashMap<>();
+        for (Map.Entry<Class<?>, Provider<CoreStartable>> entry : startables.entrySet()) {
+            String name = entry.getKey().getName();
+            if (names.contains(name.substring(name.lastIndexOf('.') + 1))) {
+                Log.i(TAG, "Skipping " + name + " (ro.deckard.skip_systemui_startables)");
+                skipped.add(entry.getKey());
+            } else {
+                kept.put(entry.getKey(), entry.getValue());
+            }
+        }
+        return kept;
+    }
+
