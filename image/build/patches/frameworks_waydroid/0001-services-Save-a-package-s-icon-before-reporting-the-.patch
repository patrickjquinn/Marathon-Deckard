From 737727270c273c3021df49fb6ce6936c2039a2b0 Mon Sep 17 00:00:00 2001
From: patrickjquinn <patrick.jm.quinn@gmail.com>
Date: Tue, 27 Oct 2026 20:08:37 +0000
Subject: [PATCH] services: Save a package's icon before reporting the package

The host writes the app's launcher as soon as it hears of the package,
and a launcher read before its icon exists shows the fallback icon:
TikTok, installed through Aurora, kept a placeholder on Marathon's home
grid. Write the icon first.
---
 services/java/id/waydro/server/WayDroidService.java | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/services/java/id/waydro/server/WayDroidService.java b/services/java/id/waydro/server/WayDroidService.java
index 629f5e4..9ec0393 100644
--- a/services/java/id/waydro/server/WayDroidService.java
+++ b/services/java/id/waydro/server/WayDroidService.java
@@ -320,10 +320,10 @@ public class WayDroidService extends SystemService {
         PackageMonitor monitor = new PackageMonitor() {
             @Override
             public void onPackageAdded(String packageName, int uid) {
+                saveApplicationIcon(packageName);
                 if (mUM != null) {
                     mUM.packageStateChanged(UserMonitor.WAYDROID_PACKAGE_ADDED, packageName, uid);
                 }
-                saveApplicationIcon(packageName);
             }
 
             @Override
@@ -338,10 +338,10 @@ public class WayDroidService extends SystemService {
 
             @Override
             public void onPackageUpdateFinished(String packageName, int uid) {
+                saveApplicationIcon(packageName);
                 if (mUM != null) {
                     mUM.packageStateChanged(UserMonitor.WAYDROID_PACKAGE_UPDATED, packageName, uid);
                 }
-                saveApplicationIcon(packageName);
             }
         };
 
-- 
2.55.0

