 codec2/service.cpp            | 4 ++--
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/codec2/C2FFMPEGVideoUtils.cpp b/codec2/C2FFMPEGVideoUtils.cpp
index 23a9c0e..b231471 100644
--- a/codec2/C2FFMPEGVideoUtils.cpp
+++ b/codec2/C2FFMPEGVideoUtils.cpp
@@ -34,7 +34,7 @@ bool C2FFMPEGVideoUtils::isGrallocMinigbm() const {
 bool C2FFMPEGVideoUtils::shouldEnableCodec(const std::string codec, bool hwonly) const {
     using namespace ::android;
 
-    const std::string supported_codecs = base::GetProperty("ro.waydroid.hwcodecs", "");
+    const std::string supported_codecs = base::GetProperty("ro.deckard.hwcodecs", "");
 
     // For MPEG-2/MPEG-4/H.263, always enable them unless hwonly is true
     if (codec.find("mpeg2") != std::string::npos) {
diff --git a/codec2/service.cpp b/codec2/service.cpp
index 8dad451..bff47a9 100644
--- a/codec2/service.cpp
+++ b/codec2/service.cpp
@@ -149,7 +149,7 @@ public:
     virtual c2_status_t createComponent(
             C2String name,
             std::shared_ptr<C2Component>* const component) override {
-        if (::android::base::GetProperty("ro.waydroid.codec2-impl", "c2.ffmpeg") != "c2.ffmpeg") {
+        if (::android::base::GetProperty("ro.deckard.codec2-impl", "c2.ffmpeg") != "c2.ffmpeg") {
             return name.starts_with("c2.ffmpeg.") ? C2_OMITTED : C2_NOT_FOUND;
         }
         ALOGD("createComponent: %s", name.c_str());
@@ -180,7 +180,7 @@ public:
     virtual c2_status_t createInterface(
             C2String name,
             std::shared_ptr<C2ComponentInterface>* const interface) override {
-        if (::android::base::GetProperty("ro.waydroid.codec2-impl", "c2.ffmpeg") != "c2.ffmpeg") {
+        if (::android::base::GetProperty("ro.deckard.codec2-impl", "c2.ffmpeg") != "c2.ffmpeg") {
             return name.starts_with("c2.ffmpeg.") ? C2_OMITTED : C2_NOT_FOUND;
         }
         ALOGD("createInterface: %s", name.c_str());
