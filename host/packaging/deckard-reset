#!/bin/sh
# Resets Android: removes the data of the user who asked (Android's /data,
# ~/.local/share/waydroid/data) so the next start sets Android up again.
# Waydroid's images and Deckard's overlay stay. Run as root through pkexec,
# by deckardd after Settings' confirmation, with that user's Android session
# already stopped.
#
# Kept in the data directory: deckard/, deckardd's sockets and the files it
# writes for Android, minus the files that crossed (xfer/, install/).
#
# Exit status: 0 done, 2 usage, 3 no Android data to remove, 1 any other
# failure.
set -u

die() {
	echo "deckard-reset: $2" >&2
	exit "$1"
}

[ $# -eq 0 ] || die 2 "usage: deckard-reset"

uid=${PKEXEC_UID:-${DECKARD_RESET_UID:-}}
case $uid in
	"" | *[!0-9]*) die 2 "run through pkexec" ;;
	0) die 2 "not for root's data" ;;
esac
systemctl=${DECKARD_RESET_SYSTEMCTL:-systemctl}

if [ -n "${DECKARD_RESET_PASSWD:-}" ]; then
	entry=$(awk -F: -v u="$uid" '$3 == u { print; exit }' "$DECKARD_RESET_PASSWD")
else
	entry=$(getent passwd "$uid")
fi
home=$(printf '%s\n' "$entry" | cut -d: -f6)
[ -n "$home" ] && [ "$home" != / ] || die 1 "no home for uid $uid"
home=$(cd -P "$home" 2> /dev/null && pwd) || die 1 "no home at $home"
data=${DECKARD_RESET_DATA:-$home/.local/share/waydroid/data}

[ -d "$data" ] || die 3 "no Android data at $data"
# Work from inside the directory, checked once there: a symlink swapped in
# afterwards can't send the removal elsewhere.
cd -P "$data" 2> /dev/null || die 3 "no Android data at $data"
here=$(pwd)
case $here in "$home"/?*) ;; *) die 1 "$here is outside $home" ;; esac
[ "$(stat -c %u .)" = "$uid" ] || die 1 "$here does not belong to uid $uid"

running=
"$systemctl" is-active --quiet waydroid-container.service && running=1
"$systemctl" stop waydroid-container.service || die 1 "cannot stop the container"

failed=
for f in ./* ./.[!.]* ./..?*; do
	[ -e "$f" ] || [ -L "$f" ] || continue
	[ "$f" = ./deckard ] && [ -d deckard ] && [ ! -L deckard ] && continue
	rm -rf -- "$f" || failed=1
done
if [ -d deckard ] && [ ! -L deckard ] && cd deckard; then
	if [ "$(pwd -P)" = "$here/deckard" ]; then
		rm -rf -- ./xfer ./install || failed=1
	fi
	cd ..
fi

# Waydroid's entries for the apps that are gone.
apps=${DECKARD_RESET_APPS:-$home/.local/share/applications}
if [ -d "$apps" ] && [ ! -L "$apps" ]; then
	find "$apps" -maxdepth 1 -type f -name 'waydroid.*.desktop' -delete
fi

if [ -n "$running" ]; then
	"$systemctl" start waydroid-container.service || die 1 "cannot start the container again"
fi
[ -z "$failed" ] || die 1 "some of $here could not be removed"
exit 0
