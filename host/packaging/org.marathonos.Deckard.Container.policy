<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">

<!-- deckard-containerd asks this for every non-root Init, which restarts
     Android from the images already on the device. -->
<policyconfig>
  <vendor>Marathon OS</vendor>
  <vendor_url>https://github.com/patrickjquinn/Marathon-Deckard</vendor_url>
  <action id="org.marathonos.Deckard.Initializer.Init">
    <description>Set up Android</description>
    <message>Authentication is required to set up Android again from its installed images</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
</policyconfig>
