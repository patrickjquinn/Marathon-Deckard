#!/bin/sh
# Copies Deckard's Android files into Waydroid's overlay, which Waydroid
# mounts over the Android system and vendor partitions when the container
# starts, and removes files an earlier version shipped. Paths listed in
# /usr/share/deckard/whiteouts become overlayfs whiteouts (0/0 character
# devices), which hide those files of the Android image (docs/slim.md).
set -eu
src=/usr/share/deckard/overlay
dst=/var/lib/waydroid/overlay
list=/var/lib/waydroid/deckard-overlay.list
wo=/usr/share/deckard/whiteouts
wolist=/var/lib/waydroid/deckard-whiteouts.list

[ -d "$src" ] || exit 0
mkdir -p "$dst"
if [ -f "$list" ]; then
	while IFS= read -r f; do
		[ -e "$src/$f" ] || rm -f "$dst/$f"
	done < "$list"
fi
(cd "$src" && find . -type f) > "$list.new"
cp -a "$src/." "$dst/"
mv "$list.new" "$list"

is_whiteout() {
	[ -c "$1" ] && [ "$(stat -c %t:%T "$1")" = 0:0 ]
}
wanted=$(grep -v -e '^[[:space:]]*#' -e '^[[:space:]]*$' "$wo" 2>/dev/null || true)
if [ -f "$wolist" ]; then
	while IFS= read -r p; do
		printf '%s\n' "$wanted" | grep -qxF "$p" && continue
		if is_whiteout "$dst/$p"; then rm -f "$dst/$p"; fi
	done < "$wolist"
fi
: > "$wolist.new"
printf '%s\n' "$wanted" | while IFS= read -r p; do
	case "$p" in "" | /* | *..*) continue ;; esac
	if ! is_whiteout "$dst/$p"; then
		if [ -e "$dst/$p" ] || [ -L "$dst/$p" ]; then
			echo "deckard-overlay-sync: $p exists in the overlay; not hiding it" >&2
			continue
		fi
		mkdir -p "$dst/$(dirname "$p")"
		mknod "$dst/$p" c 0 0
	fi
	printf '%s\n' "$p" >> "$wolist.new"
done
mv "$wolist.new" "$wolist"

# Android properties that go with the overlay (/usr/share/deckard/waydroid.prop,
# "key=value" lines): into waydroid.cfg [properties], which "waydroid init"
# and "upgrade" keep, and waydroid_base.prop, which the next session reads.
props=/usr/share/deckard/waydroid.prop
plist=/var/lib/waydroid/deckard-props.list
cfg=/var/lib/waydroid/waydroid.cfg
base=/var/lib/waydroid/waydroid_base.prop
newprops=$(grep -v -e '^[[:space:]]*#' -e '^[[:space:]]*$' "$props" 2>/dev/null || true)
{ cat "$plist" 2>/dev/null || true; printf '%s\n' "$newprops" | sed -n 's/=.*//p'; } | sort -u | while IFS= read -r k; do
	[ -n "$k" ] || continue
	for f in "$cfg" "$base"; do
		[ -f "$f" ] && sed -i "/^$k[[:space:]]*=/d" "$f"
	done
done
printf '%s\n' "$newprops" | while IFS= read -r line; do
	[ -n "$line" ] || continue
	k=${line%%=*}
	v=${line#*=}
	[ -f "$cfg" ] && sed -i "/^\[properties\]/a $k = $v" "$cfg"
	[ -f "$base" ] && printf '%s=%s\n' "$k" "$v" >> "$base"
done
printf '%s\n' "$newprops" | sed -n 's/=.*//p' > "$plist"
