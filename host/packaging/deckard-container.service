[Unit]
Description=Deckard Android container
ConditionPathExists=/run/user/1000/deckard-requested
Requisite=deckard-migrate.service
After=deckard-migrate.service

[Service]
Type=dbus
BusName=org.marathonos.Deckard.Container
UMask=0022
ExecStartPre=/usr/libexec/deckard-overlay-sync
ExecStartPre=/usr/libexec/deckard-fonts-sync
ExecStart=/usr/libexec/deckard-containerd --production-run
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
