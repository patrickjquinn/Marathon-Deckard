#!/bin/sh
# LXC start-host hook for Deckard's Android container: a memory budget sized for the
# device. memory.high makes the kernel reclaim from Android first and raises
# the memory pressure deckard-bridge answers by ending cached Android apps;
# memory.max keeps an Android out-of-memory inside the container, so it can
# never take Marathon's shell or foreground app with it.
set -eu
cg=/sys/fs/cgroup/lxc.payload.${LXC_NAME:-deckard}
[ -d "$cg" ] || exit 0
mb=$(awk '/^MemTotal:/ { print int($2 / 1024) }' /proc/meminfo)
high=$((mb * 30 / 100))
[ "$high" -ge 1536 ] || high=1536
max=$((mb * 40 / 100))
[ "$max" -ge $((high + 512)) ] || max=$((high + 512))
echo "${high}M" > "$cg/memory.high"
echo "${max}M" > "$cg/memory.max"
# Below the session when both want the CPU or the disk: Android's boot no
# longer stalls the shell, and an idle shell leaves Android all of it.
echo 50 > "$cg/cpu.weight"
echo 25 > "$cg/io.bfq.weight" 2>/dev/null || true
